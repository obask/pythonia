{
  "name": "pythonia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "vite dev",
    "desktop:dev": "concurrently -k -n WEB,ELECTRON -c cyan,green \"pnpm dev -- --host 127.0.0.1\" \"wait-on http-get://127.0.0.1:3000 && cross-env ELECTRON_START_URL=http://127.0.0.1:3000 electron electron/main.cjs\"",
    "build": "vite build",
    "desktop:preview": "pnpm build && electron electron/main.cjs",
    "desktop:pack": "pnpm build && electron-builder --dir",
    "desktop:dist": "pnpm build && electron-builder",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "app.pythonia.desktop",
    "productName": "Pythonia",
    "asar": true,
    "asarUnpack": [
      ".output/**"
    ],
    "files": [
      ".output/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "lessons",
        "to": "lessons"
      }
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education"
    }
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.0",
    "@tanstack/react-router": "1.150.0",
    "@tanstack/react-start": "1.150.0",
    "@uiw/react-codemirror": "^4.25.9",
    "gray-matter": "^4.0.3",
    "nitro": "3.0.1-alpha.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "1.150.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "typescript": "^5",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^5.1.4",
    "wait-on": "^9.0.5"
  }
}
